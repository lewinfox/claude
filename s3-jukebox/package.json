{
  "name": "s3-jukebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Search, play and download MP3s from a private S3 bucket",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "DB_PATH=${DB_PATH:-./data/jukebox.db} tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fake-s3": "node dev/fake-s3.mjs",
    "smoke": "node dev/smoke-test.mjs",
    "dev:offline": "APP_PASSWORD=dev SESSION_SECRET=dev-only-not-a-secret S3_BUCKET=lewinfox-music S3_PREFIX=library/ S3_ENDPOINT=http://127.0.0.1:9099 S3_FORCE_PATH_STYLE=true AWS_REGION=ap-southeast-2 AWS_ACCESS_KEY_ID=dev AWS_SECRET_ACCESS_KEY=dev DB_PATH=./data/jukebox.db tsx watch src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/formbody": "^8.0.1",
    "@fastify/static": "^10.1.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "music-metadata": "^11.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
