# Copy to .env and fill in. `npm run dev` loads this file automatically;
# `docker run --env-file .env` passes it to the container.
#
# Anything already set in your shell wins over what is in here.

# --- Required ---------------------------------------------------------------

# Shared password for the web UI.
APP_PASSWORD=change-me

# The library: s3://lewinfox-music/library/
S3_BUCKET=lewinfox-music
S3_PREFIX=library/
AWS_REGION=ap-southeast-2

# --- AWS credentials --------------------------------------------------------
#
# Pick ONE of the three.
#
# 1. An existing AWS CLI profile — best for local development, since no keys
#    end up in a file. Uncomment and name your profile:
# AWS_PROFILE=default
#
# 2. Explicit keys — what the deployed container uses. Uncomment both:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
#
# 3. Nothing at all, when running on AWS with an instance or task role
#    attached. The SDK finds it by itself.
#
# Setting more than one is not an error but is ambiguous: if your shell already
# exports AWS_ACCESS_KEY_ID, adding AWS_PROFILE here logs a "multiple credential
# sources" warning and the profile wins — for now. Unset one of them.
#
# The credentials need only the read-only policy in docs/aws-setup.md.

# --- Sessions ---------------------------------------------------------------

# Any long random string (e.g. `openssl rand -hex 32`). If unset, a random one
# is generated at boot and everyone is logged out on every restart.
SESSION_SECRET=

SESSION_MAX_AGE_SECONDS=2592000

# Set to true when the app is served over HTTPS. Leave false on localhost, or
# the browser will refuse to store the session cookie.
COOKIE_SECURE=false

# --- Storage ----------------------------------------------------------------

# Where the SQLite index lives. Deliberately left unset: the container defaults
# to /data/jukebox.db (the mounted volume) and `npm run dev` uses
# ./data/jukebox.db. Only set this if you want somewhere else.
# DB_PATH=

# For S3-compatible services such as MinIO, Cloudflare R2 or Backblaze B2.
# Also how dev/fake-s3.mjs is wired up — see `npm run dev:offline`.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Behaviour --------------------------------------------------------------

PORT=8080

# How long playback and download links stay valid, in seconds.
PRESIGN_EXPIRY_SECONDS=3600

# Re-scan the bucket every N minutes (0 disables it).
SYNC_INTERVAL_MINUTES=60
SYNC_ON_START=true

# Bytes read from the head of each file to extract ID3 tags.
TAG_READ_BYTES=262144
INDEX_CONCURRENCY=8
MAX_COVER_BYTES=524288

AUDIO_EXTENSIONS=.mp3
LOG_LEVEL=info
