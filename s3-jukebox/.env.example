# --- Required ---------------------------------------------------------------

# Shared password for the web UI.
APP_PASSWORD=change-me

# Bucket holding the MP3s (s3://lewinfox-music/library/).
S3_BUCKET=lewinfox-music

# --- Sessions ---------------------------------------------------------------

# Any long random string (e.g. `openssl rand -hex 32`). If unset, a random one
# is generated at boot and everyone is logged out on every restart.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=2592000

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# --- AWS --------------------------------------------------------------------

# Must be the bucket's actual region. If it's wrong the SDK will follow S3's
# redirect and still work, but every request pays an extra round trip.
AWS_REGION=ap-southeast-2

# Omit both when running on ECS/EC2/EKS with an instance or task role attached.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only index keys under this prefix (leave blank for the whole bucket).
S3_PREFIX=library/

# For S3-compatible services such as MinIO, Cloudflare R2 or Backblaze B2.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Behaviour --------------------------------------------------------------

PORT=8080
DB_PATH=/data/jukebox.db

# How long playback and download links stay valid, in seconds.
PRESIGN_EXPIRY_SECONDS=3600

# Re-scan the bucket every N minutes (0 disables it).
SYNC_INTERVAL_MINUTES=60
SYNC_ON_START=true

# Bytes read from the head of each file to extract ID3 tags.
TAG_READ_BYTES=262144
INDEX_CONCURRENCY=8
MAX_COVER_BYTES=524288

AUDIO_EXTENSIONS=.mp3
LOG_LEVEL=info
